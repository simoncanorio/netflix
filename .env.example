# Plantilla de variables de entorno (copiar a .env para uso con TMDB en vivo)
# Nota: La app también funciona sin API key gracias a data/tmdb_titles_cache.json y pósters SVG de respaldo.
TMDB_API_KEY=TU_API_KEY_DE_TMDB_AQUI
TMDB_READ_ACCESS_TOKEN=TU_BEARER_TOKEN_AQUI
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
